[Desktop Entry]
Version=1.0
Type=Application
Name=Sample Game
Comment=Launch the sample Windows game with Wine
Path=/games/sample-game
Exec=sh -c "cd '/games/sample-game' && exec env WINEARCH=win64 WINEPREFIX=/wine-prefix/sample-game /usr/bin/wine Game.exe"
Icon=applications-games
Terminal=false
Categories=Game;
StartupNotify=false
